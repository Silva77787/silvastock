<Project>
  <!-- Central package management: versions live here; csproj files reference packages without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <!-- EF Core provider for PostgreSQL (ADR-0003); 10.0.3 is built against Npgsql 10.0.3. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <!-- Pin EF Core to one patch level across the provider, Data Protection and design-time packages. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <!-- Design-time services for `dotnet ef` (migrations); private asset of SilvaStock.Infrastructure. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- snake_case table/column/key/index names for every entity, including framework-owned ones (ADR-0003). -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Data Protection key ring persisted in Postgres, table data_protection_keys (ADR-0004). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Integration tests: in-memory host for SilvaStock.Api (matches the ASP.NET Core 10 runtime). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Integration tests: disposable PostgreSQL container per test run (ADR-0003, REQUIREMENTS section 4). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>
</Project>
