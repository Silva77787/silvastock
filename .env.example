# Copy to `.env` (ignored by Git) and adjust. Placeholders only — never commit real values.

# ---- Local Postgres (docker compose) ----
POSTGRES_USER=silvastock
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=silvastock
POSTGRES_PORT=5432

# ---- Local RustFS (S3-compatible, replaces Cloudflare R2 locally) ----
# Access key: at least 3 characters. Secret key: at least 8 characters.
S3_ACCESS_KEY=silvastock
S3_SECRET_KEY=change-me-local-only
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_PHOTOS_BUCKET=photos
S3_DOCUMENTS_BUCKET=documents
