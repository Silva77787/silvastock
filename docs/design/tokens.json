        "800": { "$type": "color", "$value": "#9A3412" },
        "950": { "$type": "color", "$value": "#431407" }
      },
      "stone": {
        "50": { "$type": "color", "$value": "#FAFAF9" },
        "100": { "$type": "color", "$value": "#F5F5F4" },
        "200": { "$type": "color", "$value": "#E7E5E4" },
        "300": { "$type": "color", "$value": "#D6D3D1" },
        "400": { "$type": "color", "$value": "#A8A29E" },
        "450": { "$type": "color", "$value": "#8A837E" },
        "500": { "$type": "color", "$value": "#78716C" },
        "600": { "$type": "color", "$value": "#57534E" },
        "700": { "$type": "color", "$value": "#44403C" },
        "800": { "$type": "color", "$value": "#292524" },
        "900": { "$type": "color", "$value": "#1C1917" },
        "950": { "$type": "color", "$value": "#0C0A09" }
      },
      "green": {
        "50": { "$type": "color", "$value": "#F0FDF4" },
        "100": { "$type": "color", "$value": "#DCFCE7" },
        "300": { "$type": "color", "$value": "#86EFAC" },
        "400": { "$type": "color", "$value": "#4ADE80" },
        "700": { "$type": "color", "$value": "#15803D" },
        "800": { "$type": "color", "$value": "#166534" },
        "950": { "$type": "color", "$value": "#052E16" }
      },
      "amber": {
        "50": { "$type": "color", "$value": "#FFFBEB" },
        "300": { "$type": "color", "$value": "#FCD34D" },
        "700": { "$type": "color", "$value": "#B45309" },
        "800": { "$type": "color", "$value": "#92400E" },
        "950": { "$type": "color", "$value": "#451A03" }
      },
      "red": {
        "50": { "$type": "color", "$value": "#FEF2F2" },
        "300": { "$type": "color", "$value": "#FCA5A5" },
        "400": { "$type": "color", "$value": "#F87171" },
        "700": { "$type": "color", "$value": "#B91C1C" },
        "800": { "$type": "color", "$value": "#991B1B" },
        "950": { "$type": "color", "$value": "#450A0A" }
      },
      "blue": {
        "50": { "$type": "color", "$value": "#EFF6FF" },
        "300": { "$type": "color", "$value": "#93C5FD" },
        "700": { "$type": "color", "$value": "#1D4ED8" },
        "800": { "$type": "color", "$value": "#1E40AF" },
        "950": { "$type": "color", "$value": "#172554" }
      },
      "violet": {
        "100": { "$type": "color", "$value": "#EDE9FE" },
        "300": { "$type": "color", "$value": "#C4B5FD" },
        "800": { "$type": "color", "$value": "#5B21B6" },
        "950": { "$type": "color", "$value": "#2E1065" }
      }
    }
  },
  "theme": {
    "light": {
      "color": {
        "bg": {
          "canvas": { "$type": "color", "$value": "{primitive.color.white}", "$description": "Default page background (admin, detail page)." },
          "subtle": { "$type": "color", "$value": "{primitive.color.stone.50}", "$description": "Background behind card grids (catalogue) and admin content area." },
          "surface": { "$type": "color", "$value": "{primitive.color.white}", "$description": "Cards, panels, inputs, table." },
          "raised": { "$type": "color", "$value": "{primitive.color.white}", "$description": "Dialogs, menus, toasts, drawers (always with shadow)." },
          "muted": { "$type": "color", "$value": "{primitive.color.stone.100}", "$description": "Hover rows, skeletons, image placeholders, chips." },
          "overlay": { "$type": "color", "$value": "rgba(12, 10, 9, 0.60)", "$description": "Backdrop behind dialogs and drawers." }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{primitive.color.stone.900}" },
          "secondary": { "$type": "color", "$value": "{primitive.color.stone.600}" },
          "disabled": { "$type": "color", "$value": "{primitive.color.stone.400}", "$description": "Disabled controls only (exempt from contrast)." },
          "inverse": { "$type": "color", "$value": "{primitive.color.white}" },
          "link": { "$type": "color", "$value": "{primitive.color.teal.600}" },
          "linkHover": { "$type": "color", "$value": "{primitive.color.teal.700}" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{primitive.color.stone.200}", "$description": "Decorative dividers (table rows, section separators)." },
          "default": { "$type": "color", "$value": "{primitive.color.stone.300}", "$description": "Card and panel outlines (decorative)." },
          "strong": { "$type": "color", "$value": "{primitive.color.stone.500}", "$description": "Input/checkbox/secondary-button borders. ≥3:1 against bg.surface/raised (WCAG 1.4.11)." }
        },
        "action": {
          "primary": {
            "bg": { "$type": "color", "$value": "{primitive.color.teal.600}" },
            "bgHover": { "$type": "color", "$value": "{primitive.color.teal.700}" },
            "bgActive": { "$type": "color", "$value": "{primitive.color.teal.800}" },
            "fg": { "$type": "color", "$value": "{primitive.color.white}" }
          },
          "danger": {
            "bg": { "$type": "color", "$value": "{primitive.color.red.700}" },
            "bgHover": { "$type": "color", "$value": "{primitive.color.red.800}" },
            "fg": { "$type": "color", "$value": "{primitive.color.white}" }
          },
          "selected": {
            "bg": { "$type": "color", "$value": "{primitive.color.teal.50}", "$description": "Active nav item, selected chip/row." },
            "fg": { "$type": "color", "$value": "{primitive.color.teal.700}" }
          }
        },
        "accent": {
          "price": { "$type": "color", "$value": "{primitive.color.orange.700}", "$description": "Price text only. Never as a button background." },
          "bg": { "$type": "color", "$value": "{primitive.color.orange.50}" },
          "fg": { "$type": "color", "$value": "{primitive.color.orange.800}" }
        },
        "feedback": {
          "success": {
            "fg": { "$type": "color", "$value": "{primitive.color.green.700}" },
            "bg": { "$type": "color", "$value": "{primitive.color.green.50}" },
            "border": { "$type": "color", "$value": "{primitive.color.green.300}" }
          },
          "warning": {
            "fg": { "$type": "color", "$value": "{primitive.color.amber.700}" },
            "bg": { "$type": "color", "$value": "{primitive.color.amber.50}" },
            "border": { "$type": "color", "$value": "{primitive.color.amber.300}" }
          },
          "danger": {
            "fg": { "$type": "color", "$value": "{primitive.color.red.700}" },
            "bg": { "$type": "color", "$value": "{primitive.color.red.50}" },
            "border": { "$type": "color", "$value": "{primitive.color.red.300}" }
          },
          "info": {
            "fg": { "$type": "color", "$value": "{primitive.color.blue.700}" },
            "bg": { "$type": "color", "$value": "{primitive.color.blue.50}" },
            "border": { "$type": "color", "$value": "{primitive.color.blue.300}" }
          }
        },
        "status": {
          "draft": {
            "fg": { "$type": "color", "$value": "{primitive.color.stone.700}" },
            "bg": { "$type": "color", "$value": "{primitive.color.stone.100}" }
          },
          "published": {
            "fg": { "$type": "color", "$value": "{primitive.color.green.800}" },
            "bg": { "$type": "color", "$value": "{primitive.color.green.100}" }
          },
          "sold": {
            "fg": { "$type": "color", "$value": "{primitive.color.violet.800}" },
            "bg": { "$type": "color", "$value": "{primitive.color.violet.100}" }
          }
        },
        "focus": {
          "ring": { "$type": "color", "$value": "{primitive.color.orange.700}", "$description": "2px outline, 2px offset, on every focusable element (:focus-visible)." }
        }
      },
      "shadow": {
        "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgba(28, 25, 23, 0.06)" },
        "md": { "$type": "shadow", "$value": "0 2px 4px -1px rgba(28, 25, 23, 0.06), 0 4px 8px -2px rgba(28, 25, 23, 0.08)" },
        "lg": { "$type": "shadow", "$value": "0 8px 16px -4px rgba(28, 25, 23, 0.10), 0 16px 32px -8px rgba(28, 25, 23, 0.12)" }
      }
    },
    "dark": {
      "color": {
        "bg": {
          "canvas": { "$type": "color", "$value": "{primitive.color.stone.950}" },
          "subtle": { "$type": "color", "$value": "{primitive.color.stone.950}" },
          "surface": { "$type": "color", "$value": "{primitive.color.stone.900}" },
          "raised": { "$type": "color", "$value": "{primitive.color.stone.800}" },
          "muted": { "$type": "color", "$value": "{primitive.color.stone.800}" },
          "overlay": { "$type": "color", "$value": "rgba(0, 0, 0, 0.70)" }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{primitive.color.stone.50}" },
          "secondary": { "$type": "color", "$value": "{primitive.color.stone.400}" },
          "disabled": { "$type": "color", "$value": "{primitive.color.stone.600}" },
          "inverse": { "$type": "color", "$value": "{primitive.color.stone.950}" },
          "link": { "$type": "color", "$value": "{primitive.color.teal.300}" },
          "linkHover": { "$type": "color", "$value": "{primitive.color.teal.200}" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{primitive.color.stone.800}" },
          "default": { "$type": "color", "$value": "{primitive.color.stone.700}" },
          "strong": { "$type": "color", "$value": "{primitive.color.stone.450}" }
        },
        "action": {
          "primary": {
            "bg": { "$type": "color", "$value": "{primitive.color.teal.300}" },
            "bgHover": { "$type": "color", "$value": "{primitive.color.teal.200}" },
            "bgActive": { "$type": "color", "$value": "{primitive.color.teal.100}" },
            "fg": { "$type": "color", "$value": "{primitive.color.teal.950}" }
          },
          "danger": {
            "bg": { "$type": "color", "$value": "{primitive.color.red.400}" },
            "bgHover": { "$type": "color", "$value": "{primitive.color.red.300}" },
            "fg": { "$type": "color", "$value": "{primitive.color.stone.950}" }
          },
          "selected": {
            "bg": { "$type": "color", "$value": "{primitive.color.teal.900}" },
            "fg": { "$type": "color", "$value": "{primitive.color.teal.200}" }
          }
        },
        "accent": {
          "price": { "$type": "color", "$value": "{primitive.color.orange.400}" },
          "bg": { "$type": "color", "$value": "{primitive.color.orange.950}" },
          "fg": { "$type": "color", "$value": "{primitive.color.orange.300}" }
        },
        "feedback": {
          "success": {
            "fg": { "$type": "color", "$value": "{primitive.color.green.400}" },
            "bg": { "$type": "color", "$value": "{primitive.color.green.950}" },
            "border": { "$type": "color", "$value": "{primitive.color.green.800}" }
          },
          "warning": {
            "fg": { "$type": "color", "$value": "{primitive.color.amber.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.amber.950}" },
            "border": { "$type": "color", "$value": "{primitive.color.amber.800}" }
          },
          "danger": {
            "fg": { "$type": "color", "$value": "{primitive.color.red.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.red.950}" },
            "border": { "$type": "color", "$value": "{primitive.color.red.800}" }
          },
          "info": {
            "fg": { "$type": "color", "$value": "{primitive.color.blue.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.blue.950}" },
            "border": { "$type": "color", "$value": "{primitive.color.blue.800}" }
          }
        },
        "status": {
          "draft": {
            "fg": { "$type": "color", "$value": "{primitive.color.stone.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.stone.800}" }
          },
          "published": {
            "fg": { "$type": "color", "$value": "{primitive.color.green.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.green.950}" }
          },
          "sold": {
            "fg": { "$type": "color", "$value": "{primitive.color.violet.300}" },
            "bg": { "$type": "color", "$value": "{primitive.color.violet.950}" }
          }
        },
        "focus": {
          "ring": { "$type": "color", "$value": "{primitive.color.orange.300}" }
        }
      },
      "shadow": {
        "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.40)" },
        "md": { "$type": "shadow", "$value": "0 2px 4px -1px rgba(0, 0, 0, 0.40), 0 4px 8px -2px rgba(0, 0, 0, 0.40)" },
        "lg": { "$type": "shadow", "$value": "0 8px 16px -4px rgba(0, 0, 0, 0.50), 0 16px 32px -8px rgba(0, 0, 0, 0.50)" }
      }
