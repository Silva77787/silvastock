  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$description": "Inter variable (Google Fonts, OFL), self-hosted via next/font/google, subsets latin + latin-ext, display swap." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" }
    }
  },
  "typography": {
    "$description": "Text styles. 'mobile' overrides apply below the md breakpoint (768px). All numeric values in prices, mileage, years and counters use font-variant-numeric: tabular-nums.",
    "display": { "$type": "typography", "$value": { "fontSize": "36px", "lineHeight": "40px", "fontWeight": 700, "letterSpacing": "-0.02em" }, "mobile": { "fontSize": "30px", "lineHeight": "36px" } },
    "h1": { "$type": "typography", "$value": { "fontSize": "30px", "lineHeight": "36px", "fontWeight": 700, "letterSpacing": "-0.02em" }, "mobile": { "fontSize": "24px", "lineHeight": "32px" } },
    "h2": { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600, "letterSpacing": "-0.01em" }, "mobile": { "fontSize": "20px", "lineHeight": "28px" } },
    "h3": { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "-0.01em" } },
    "h4": { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "0" } },
    "bodyLg": { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "28px", "fontWeight": 400, "letterSpacing": "0" } },
    "body": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400, "letterSpacing": "0" } },
    "bodySm": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "0" } },
    "label": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500, "letterSpacing": "0" } },
    "caption": { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0.01em" } },
    "button": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "0" } },
    "buttonSm": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 600, "letterSpacing": "0" } },
    "priceLg": { "$type": "typography", "$value": { "fontSize": "30px", "lineHeight": "36px", "fontWeight": 700, "letterSpacing": "-0.01em", "fontVariantNumeric": "tabular-nums" }, "mobile": { "fontSize": "24px", "lineHeight": "32px" } },
    "price": { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 700, "letterSpacing": "-0.01em", "fontVariantNumeric": "tabular-nums" } },
    "stat": { "$type": "typography", "$value": { "fontSize": "36px", "lineHeight": "40px", "fontWeight": 700, "letterSpacing": "-0.02em", "fontVariantNumeric": "tabular-nums" } }
  },
  "space": {
    "$description": "4px base scale. Use only these values for padding, margin and gap.",
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "4px", "$description": "Checkbox, small tags." },
    "md": { "$type": "dimension", "$value": "8px", "$description": "Buttons, inputs, selects, thumbnails, toasts." },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "Cards, panels, dialogs, gallery main image." },
    "xl": { "$type": "dimension", "$value": "16px", "$description": "Bottom sheet top corners, login card." },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Badges, chips, avatar, pagination current page." }
  },
  "borderWidth": {
    "default": { "$type": "dimension", "$value": "1px" },
    "focus": { "$type": "dimension", "$value": "2px" }
  },
  "size": {
    "control": {
      "sm": { "$type": "dimension", "$value": "36px", "$description": "Small buttons/inputs (admin tables, toolbars). Minimum target with spacing per WCAG 2.5.8." },
      "md": { "$type": "dimension", "$value": "44px", "$description": "Default height for buttons, inputs, selects." },
      "lg": { "$type": "dimension", "$value": "52px", "$description": "Login button, mobile sticky CTA." }
    },
    "icon": {
      "sm": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "20px" },
      "lg": { "$type": "dimension", "$value": "24px" }
    },
    "header": {
      "public": { "$type": "dimension", "$value": "64px" },
      "admin": { "$type": "dimension", "$value": "56px" }
    },
    "sidebar": {
      "admin": { "$type": "dimension", "$value": "240px" },
      "filters": { "$type": "dimension", "$value": "280px" }
    },
    "container": {
      "public": { "$type": "dimension", "$value": "1200px" },
      "admin": { "$type": "dimension", "$value": "1120px" },
      "form": { "$type": "dimension", "$value": "880px" },
      "prose": { "$type": "dimension", "$value": "720px" }
    }
  },
  "breakpoint": {
    "$description": "Mobile-first min-width media queries. mobile = <768px, tablet = 768–1023px, desktop = ≥1024px.",
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  },
  "gutter": {
    "mobile": { "$type": "dimension", "$value": "16px" },
    "tablet": { "$type": "dimension", "$value": "24px" },
    "desktop": { "$type": "dimension", "$value": "32px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms", "$description": "Hover, colour changes." },
      "base": { "$type": "duration", "$value": "200ms", "$description": "Dropdowns, toasts in, dialogs." },
      "slow": { "$type": "duration", "$value": "300ms", "$description": "Drawers / bottom sheet." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
