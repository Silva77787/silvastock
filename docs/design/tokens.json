{
  "$description": "SilvaStock design tokens (v1). Source of truth for colours, typography, spacing, radii, shadows, breakpoints, motion and z-index. Colours: 'primitive' holds raw palette values; 'theme.light' and 'theme.dark' hold semantic tokens that components MUST use (never primitives directly). References use the {path.to.token} syntax. tokens.css is generated from this file and must stay identical in values.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "teal": {
        "50": { "$type": "color", "$value": "#EEF7F6" },
        "100": { "$type": "color", "$value": "#D3EBE8" },
        "200": { "$type": "color", "$value": "#A6D6D1" },
        "300": { "$type": "color", "$value": "#6FBBB4" },
        "400": { "$type": "color", "$value": "#3A9A92" },
        "500": { "$type": "color", "$value": "#1F7C75" },
        "600": { "$type": "color", "$value": "#0F5E5A" },
        "700": { "$type": "color", "$value": "#0C4E4B" },
        "800": { "$type": "color", "$value": "#0A3F3D" },
        "900": { "$type": "color", "$value": "#082F2E" },
        "950": { "$type": "color", "$value": "#041C1B" }
